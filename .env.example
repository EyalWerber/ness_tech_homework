# Terminal X credentials
TERMINALX_USERNAME=your@email.com
TERMINALX_PASSWORD=yourpassword

# Session state – reused across tests to avoid repeated logins
SESSION_STATE_PATH=reports/session_state.json

# AI layer – Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5

# OpenAI fallback (comment out OLLAMA_BASE_URL to use this instead)
# OPENAI_API_KEY=your_key_here

# Master AI switch
AI_ENABLED=false

# Per-feature toggles (only apply when AI_ENABLED=true)
AI_SELF_HEALING_ENABLED=true
AI_FAILURE_ANALYSIS_ENABLED=true

# Browser
BROWSER=chromium
HEADLESS=false

# Timeouts – 0 means no timeout (Playwright native behaviour)
REQUEST_TIMEOUT=0
AI_TIMEOUT=15

# Slow down every browser action by N milliseconds (useful for watching tests run)
SLOW_MO=700

# Paths
SCREENSHOT_DIR=reports/screenshots
